{
  "compilerOptions": {
    "target": "ES2020",
    "module": "es2020",
    "lib": ["ES2020"],
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "outDir": "./dist",
    "rootDir": "./",
    "types": ["node", "vitest/globals"]
  },
  "ts-node": {
    "transpileOnly": true,
    "compilerOptions": {
      "module": "es2020",
      "moduleResolution": "bundler"
    }
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
