# Network configuration
NETWORK=testnet

# Contract addresses (set after deployment)
# Run `cd ../publish && ./publish.sh` to auto-populate these values
PACKAGE_ADDRESS=0x...
FAUCET_ID=0x...
ROBOT_PET_ID=0x...
REGISTRY_ID=0x...

# User wallet (choose one)
USER_PHRASE="twelve word mnemonic phrase here"
# OR
# USER_PRIVATE_KEY=suiprivkey1qq...

# For operators registering robots
OPERATOR_PHRASE="twelve word mnemonic phrase for operator"
# OR
# OPERATOR_PRIVATE_KEY=suiprivkey1qq...

# Robot registration (for register-robot.ts)
ROBOT_NAME="Bittle-1"
ROBOT_DESCRIPTION="A friendly robot dog"
ROBOT_TYPE="Petoi Bittle X"
ROBOT_PRICE_PER_MINUTE=2

# Session configuration (for start-session.ts)
SESSION_ROBOT_NAME="Bittle-1"
SESSION_MINUTES=5
SESSION_ID=0x...
