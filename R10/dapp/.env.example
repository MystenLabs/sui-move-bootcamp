# Robot Rental Platform - dApp Configuration
# Copy this file to .env and fill in the values after deploying contracts

# Package ID (from sui client publish)
VITE_PACKAGE_ID=0x...

# Faucet object ID (created during deployment)
VITE_FAUCET_ID=0x...

# Robot Pet object ID (created via create_robot)
VITE_ROBOT_PET_ID=0x...

# Robot Registry object ID (created via create_registry)
VITE_REGISTRY_ID=0x...

# WebSocket server URL for real-time robot control
VITE_WS_URL=ws://localhost:8080
