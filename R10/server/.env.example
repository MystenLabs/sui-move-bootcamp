# Robot Rental WebSocket Server Configuration
# Copy this file to .env and fill in the values
# Run `cd ../publish && ./publish.sh` to auto-populate contract addresses

# ============================================
# SERVER CONFIGURATION
# ============================================

# WebSocket server port
WEBSOCKET_PORT=8080

# Client ping interval (milliseconds) - how often to check client connectivity
PING_INTERVAL_MS=30000

# Session check interval (milliseconds) - how often to verify sessions on blockchain
SESSION_CHECK_INTERVAL_MS=60000

# Client timeout (milliseconds) - disconnect clients with no activity
CLIENT_TIMEOUT_MS=120000

# ============================================
# SUI NETWORK
# ============================================

# Network: testnet, devnet, or mainnet
NETWORK=testnet

# Custom RPC URL (optional - defaults to official fullnode)
# SUI_RPC_URL=https://fullnode.testnet.sui.io

# ============================================
# CONTRACT ADDRESSES
# ============================================

# Package address (from sui client publish)
PACKAGE_ADDRESS=

# Robot Registry object ID (shared object)
REGISTRY_ID=

# ============================================
# ROBOT CONNECTION
# ============================================

# Set to true to run without physical robot (for testing)
SIMULATE_ROBOT=true

# Serial port for physical robot (e.g., /dev/ttyACM0, /dev/cu.usbmodem*)
SERIAL_PORT=

# Serial baud rate (Petoi Bittle uses 115200)
SERIAL_BAUD_RATE=115200

# ============================================
# DEBUGGING
# ============================================

# Enable debug logging
DEBUG=false
