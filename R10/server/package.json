{
  "name": "robot-rental-server",
  "version": "1.0.0",
  "description": "WebSocket server for robot rental with Ed25519 authentication",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "tunnel": "./scripts/start-tunnel.sh",
    "start:tunnel": "./scripts/start-all.sh"
  },
  "keywords": [
