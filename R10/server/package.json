    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0",
    "dotenv": "^16.6.1",
    "ws": "^8.19.0"
  },
  "optionalDependencies": {
    "serialport": "^12.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@types/ws": "^8.18.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
