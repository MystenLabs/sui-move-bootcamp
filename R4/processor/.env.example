# ============================================
# BLOCKCHAIN CONFIGURATION
# ============================================

# Network: devnet, testnet, or mainnet
NETWORK=testnet

# Contract package address (from Module 2 deployment)
PACKAGE_ADDRESS=0x...

# Action queue object ID (from Module 2 create-queue)
QUEUE_ID=0x...

# Admin wallet phrase (must be the queue creator to pop actions)
ADMIN_PHRASE="your twelve word recovery phrase goes here"

# ============================================
# ROBOT CONFIGURATION
# ============================================

# Serial port for Bittle connection
# macOS: /dev/cu.usbmodem* or /dev/cu.usbserial*
# Linux: /dev/ttyACM0 or /dev/ttyUSB0
SERIAL_PORT=/dev/ttyACM0

# Baud rate (Bittle uses 115200)
BAUD_RATE=115200

# ============================================
# PROCESSOR CONFIGURATION
# ============================================

# How often to check for new actions (milliseconds)
POLL_INTERVAL_MS=5000

# Delay between executing actions (milliseconds)
ACTION_DELAY_MS=1000

# Enable verbose logging
DEBUG=false
