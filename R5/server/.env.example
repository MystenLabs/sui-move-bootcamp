# ============================================
# SERVER CONFIGURATION
# ============================================

# Port for HTTP and WebSocket server
PORT=8080

# ============================================
# ROBOT CONFIGURATION
# ============================================

# Serial port for Bittle connection
# macOS: /dev/cu.usbmodem* or /dev/cu.usbserial*
# Linux: /dev/ttyACM0 or /dev/ttyUSB0
SERIAL_PORT=/dev/ttyACM0

# Baud rate (Bittle uses 115200)
BAUD_RATE=115200

# ============================================
# CONTROL SETTINGS
# ============================================

# Enable command queuing (true) or drop commands when busy (false)
QUEUE_COMMANDS=true

# Maximum queue size (prevents memory issues)
MAX_QUEUE_SIZE=10

# Enable verbose logging
DEBUG=false
